---
import type { MarkdownHeading } from "astro";
import { siteConfig, profileConfig } from "../config";
import { getSortedPosts } from "../utils/content-utils";
import { getPostUrlBySlug, url, pathsEqual } from "../utils/url-utils";
import Profile from "../components/widget/Profile.astro";
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/700.css";
import "@fontsource-variable/jetbrains-mono";
import "katex/dist/katex.css";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/expressive-code.css";
import "../styles/ctf-layout.css";
interface Props {
  title?: string;
  banner?: string;
  description?: string;
  lang?: string;
  setOGTypeArticle?: boolean;
  headings?: MarkdownHeading[];
  showProfile?: boolean;
}
const { title, description, lang, setOGTypeArticle, headings = [], showProfile = false } = Astro.props;
const posts = await getSortedPosts();
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const group = post.data.ctf || post.data.category || "Notes";
  groups.set(group, [...(groups.get(group) || []), post]);
}
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const toc = headings.filter(h => h.depth > 1 && h.depth <= siteConfig.toc.depth + 1);
---
<!doctype html>
<html lang={(lang || siteConfig.lang).replace('_', '-')} class="dark" style="--hue: 285">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description || siteConfig.subtitle} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description || siteConfig.subtitle} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={setOGTypeArticle ? "article" : "website"} />
  <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={url('/rss.xml')} />
  <link rel="icon" type="image/svg+xml" href={url('/ctf-mark.svg')} />
  <slot name="head" />
</head>
<body>
  <a href="#reading-pane" class="skip-link">Đến nội dung</a>
  <div class="ctf-shell">
    <aside class="explorer" aria-label="Danh sách bài viết">
      <header class="explorer-header">
        <a class="brand" href={url('/')}><span aria-hidden="true">◆</span> {siteConfig.title}</a>
        <nav aria-label="Điều hướng"><a href={url('/about/')}>ABOUT</a><a href={url('/archive/')}>ARCHIVE</a><a href={url('/rss.xml')}>RSS</a></nav>
      </header>
      <div class="identity"><span>{profileConfig.name}</span><span>REVERSE / RESEARCH / NOTES</span></div>
      <div class="stats">POSTS <b>{posts.length}</b><span>·</span> GROUPS <b>{groups.size}</b><span class="status-dot" aria-label="Online"></span></div>
      <button class="mobile-toggle" aria-expanded="false" aria-controls="explorer-content">Danh sách bài viết <span>⌄</span></button>
      <div id="explorer-content">
        <div class="search-row"><label class="search-box"><span aria-hidden="true">⌕</span><input id="post-search" type="search" placeholder="Search write-ups…" aria-label="Tìm theo tên, tag hoặc giải CTF" /></label><button id="fold-groups" title="Thu gọn hoặc mở các nhóm" aria-label="Thu gọn hoặc mở các nhóm">☷</button></div>
        <div class="post-groups">
          {[...groups].map(([name, entries]) => <details class="post-group" open>
            <summary><span class="diamond">◆</span><span class="group-title">{name}</span><span class="dotted"></span><b>{entries.length}</b></summary>
            <div class="group-posts">{entries.map(post => <a class:list={["explorer-post", { selected: pathsEqual(Astro.url.pathname, getPostUrlBySlug(post.slug)) }]} aria-current={pathsEqual(Astro.url.pathname, getPostUrlBySlug(post.slug)) ? 'page' : undefined} href={getPostUrlBySlug(post.slug)} data-search={`${post.data.title} ${name} ${post.data.tags.join(' ')} ${post.data.difficulty}`}>
              <span class="post-marker" aria-hidden="true">◇</span>
              <div class="post-info"><div class="post-topline"><strong>{post.data.title}</strong>{post.data.points !== undefined && <span class="points">{post.data.points}<small> pts</small></span>}</div><div class="post-bottomline"><div class="mini-tags">{post.data.tags.slice(0,3).map(tag => <span>{tag}</span>)}</div><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('en-GB', {timeZone: 'UTC'})}</time>{post.data.difficulty && <span>{post.data.difficulty}</span>}</div></div>
            </a>)}</div>
          </details>)}
          <p id="empty-search" hidden role="status">Không tìm thấy bài phù hợp.</p>
        </div>
      </div>
      <footer class="explorer-footer"><span>© {new Date().getFullYear()} {profileConfig.name}</span><a href="https://github.com/vtnam207" target="_blank" rel="noopener noreferrer">GITHUB ↗</a></footer>
    </aside>

    {showProfile ? (
      <main id="reading-pane" tabindex="-1" class="reading-pane profile-pane">
        <div class="reader-top"><a href={url('/')}>{siteConfig.title}</a><span>PROFILE <span aria-hidden="true">✦</span></span></div>
        <div class="profile-home">
          <Profile />
          <div class="profile-about">
            <span class="profile-kicker">VTNAM207 / CTF / REVERSE</span>
            <h1>{profileConfig.name}</h1>
            <p>{profileConfig.bio}</p>
            <div class="profile-actions">
              <a href={url('/about/')}>ABOUT</a>
              <a href="https://github.com/vtnam207" target="_blank" rel="noopener noreferrer">GITHUB ↗</a>
            </div>
          </div>
        </div>
        <footer class="reader-footer"><span>{siteConfig.subtitle}</span><a href="#reading-pane">↑ Đầu trang</a></footer>
      </main>
    ) : (
      <main id="reading-pane" tabindex="-1" class:list={["reading-pane", { 'has-toc': siteConfig.toc.enable && toc.length > 0 }]}>
        <div class="reader-top"><a href={url('/')}>{siteConfig.title}</a><span>FIELD NOTES <span aria-hidden="true">✦</span></span></div>
        <div class="reader-grid"><div class="reader-content"><slot /></div>
        {siteConfig.toc.enable && toc.length > 0 && <nav id="toc" class="reader-toc" aria-label="Mục lục"><p>MỤC LỤC</p>{toc.map(h => <a class:list={[{subheading: h.depth > 2}]} href={`#${h.slug}`}>{h.text}</a>)}</nav>}
        </div>
        <footer class="reader-footer">{siteConfig.subtitle}<a href="#reading-pane">↑ Đầu trang</a></footer>
      </main>
    )}
  </div>
</body>
</html>
<script>
const search = document.querySelector<HTMLInputElement>('#post-search');
const groups = [...document.querySelectorAll<HTMLDetailsElement>('.post-group')];
search?.addEventListener('input', () => {
  const query = search.value.toLocaleLowerCase().trim();
  let total = 0;
  for (const group of groups) {
    let count = 0;
    for (const item of group.querySelectorAll<HTMLAnchorElement>('[data-search]')) {
      item.hidden = !item.dataset.search?.toLocaleLowerCase().includes(query);
      if (!item.hidden) count++;
    }
    group.hidden = count === 0;
    if (query) group.open = true;
    total += count;
  }
  const empty = document.getElementById('empty-search');
  if (empty) empty.hidden = total > 0;
});
document.getElementById('fold-groups')?.addEventListener('click', () => {
  const open = !groups.some(g => !g.hidden && g.open);
  groups.forEach(g => { g.open = open; });
});
document.querySelector('.mobile-toggle')?.addEventListener('click', event => {
  const button = event.currentTarget as HTMLButtonElement;
  const expanded = button.getAttribute('aria-expanded') !== 'true';
  button.setAttribute('aria-expanded', String(expanded));
  document.querySelector('.explorer')?.classList.toggle('expanded', expanded);
});
const links = [...document.querySelectorAll<HTMLAnchorElement>('.reader-toc a')];
if (links.length) {
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) if (entry.isIntersecting) {
      links.forEach(link => link.classList.toggle('active', decodeURIComponent(link.hash.slice(1)) === entry.target.id));
    }
  }, {rootMargin: '0px 0px -65% 0px'});
  links.forEach(link => { const target = document.getElementById(decodeURIComponent(link.hash.slice(1))); if(target) observer.observe(target); });
}
</script>
