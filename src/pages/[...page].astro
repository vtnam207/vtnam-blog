---
import type { GetStaticPaths } from "astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getTagUrl } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const recentPage = { ...page, data: page.data.slice(0, 4) };
const featuredTags = [
	"Reverse Engineering",
	"CTF",
	"Windows",
	"Crypto",
	"Web Exploit",
	"Tips & Tricks",
];
---

<MainGridLayout showProfile={true}>
  <label class="home-search"><span aria-hidden="true">⌕</span><input id="home-post-search" type="search" placeholder="Search posts, tags, or keywords…" aria-label="Search posts, tags, or keywords" /><kbd>Ctrl</kbd><kbd>K</kbd></label>
  <div class="section-heading"><h2><span aria-hidden="true">✦</span> Latest Posts</h2><span class="heading-line"></span><a href="/archive/">View all <span aria-hidden="true">→</span></a></div>
  <PostPage page={recentPage}></PostPage>
  <p id="empty-post-search" class="empty-search" hidden>No matching posts. Try another keyword.</p>
  <section class="featured-tags" aria-label="Featured tags">
    <h2><span aria-hidden="true">♢</span> Featured Tags</h2>
    <div>{featuredTags.map((tag) => <a href={getTagUrl(tag)}>{tag}</a>)}</div>
    <a class="keep-hacking" href="https://github.com/vtnam207" target="_blank" rel="noopener noreferrer" aria-label="Keep Hacking — GitHub"><img src="/assets/images/keep-hacking-reference.png" alt="Pixel cat — Keep Hacking _" width="176" height="77" loading="lazy" /></a>
  </section>
</MainGridLayout>
