---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}

const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const hasCover = Boolean(image);
const { remarkPluginFrontmatter } = await entry.render();
const label = entry.data.ctf || category || tags[0] || "NOTES";
const summary = description || remarkPluginFrontmatter.excerpt;
const searchText = [title, label, ...tags, summary, entry.data.difficulty]
	.filter(Boolean)
	.join(" ")
	.toLocaleLowerCase();
const date = published.toLocaleDateString("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});
---
<article data-post-card data-search={searchText} class:list={["post-card", Astro.props.class]} style={style}>
  <a class="post-cover" href={url} aria-label={`Read ${title}`}>
    {hasCover
      ? <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt={`Cover image for ${title}`} class="post-cover-image" />
      : <span class="cover-placeholder" aria-hidden="true">✦</span>}
  </a>
  <div class="post-copy">
    <span class="post-category">{label}</span>
    <a class="post-title" href={url}>{title}</a>
    <p class="post-description">{summary}</p>
    <div class="post-meta">
      <span><Icon name="fa6-regular:calendar" /> {date}</span>
      <span><Icon name="fa6-regular:clock" /> {remarkPluginFrontmatter.minutes} min read</span>
    </div>
  </div>
  <a class="post-arrow" href={url} aria-label={`Open ${title}`}><Icon name="fa6-solid:arrow-right" /></a>
</article>
