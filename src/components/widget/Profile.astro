---
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
---
<section class="profile-card">
  <a aria-label="Go to About page" href={url("/about/")} class="profile-avatar-frame">
    <img class="profile-avatar" src={url(profileConfig.avatar || "/assets/images/profile.webp")} alt={`Avatar of ${profileConfig.name}`} width="256" height="256" fetchpriority="high" />
    <span class="avatar-corner top-left" aria-hidden="true"></span>
    <span class="avatar-corner top-right" aria-hidden="true"></span>
    <span class="avatar-corner bottom-left" aria-hidden="true"></span>
    <span class="avatar-corner bottom-right" aria-hidden="true"></span>
  </a>
  <div class="profile-name">{profileConfig.name}<span class="name-cursor">_</span></div>
  <p class="profile-bio">{profileConfig.bio || "Better to be curious than certain."}</p>
  <div class="profile-location"><span class="online-dot"></span><span>ONLINE</span><span class="location-divider">│</span><span>⌖ Vietnam</span></div>
</section>
